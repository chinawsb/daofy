<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="fpc_stacktracer"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units>
      <Unit>
        <Filename Value="fpc_stacktracer.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="DwarfTypes.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DwarfTypes"/>
        <HasResources Value="False"/>
        <Type Value="Unit"/>
      </Unit>
      <Unit>
        <Filename Value="DwarfReader.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DwarfReader"/>
        <HasResources Value="False"/>
        <Type Value="Unit"/>
      </Unit>
      <Unit>
        <Filename Value="DwarfParser.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DwarfParser"/>
        <HasResources Value="False"/>
        <Type Value="Unit"/>
      </Unit>
      <Unit>
        <Filename Value="SymbolEmbedder.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="SymbolEmbedder"/>
        <HasResources Value="False"/>
        <Type Value="Unit"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="fpc_stacktracer"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf2Set"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="False"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
